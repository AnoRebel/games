{
  "name": "games",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "pwa:assets": "pwa-assets-generator",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:bench": "vitest run packages/game-ai/test/benchmark.test.ts",
    "smoke:boards": "cd scripts/smoke && bun run boards.ts",
    "smoke:themes": "cd scripts/smoke && bun run themes.ts"
  },
  "dependencies": {
    "@games/engine-core": "workspace:*",
    "@games/game-ai": "workspace:*",
    "@games/game-albastini": "workspace:*",
    "@games/game-bao": "workspace:*",
    "@games/game-checkers": "workspace:*",
    "@games/game-last-card": "workspace:*",
    "@conduit/client": "npm:@jsr/conduit__client",
    "@conduit/server": "npm:@jsr/conduit__server",
    "@date-fns/tz": "^1.5.0",
    "@libsql/client": "^0.18.0",
    "@nuxt/fonts": "1.2.0",
    "@nuxt/icon": "2.6.1",
    "@nuxt/image": "2.2.0",
    "@nuxt/scripts": "1.3.12",
    "@nuxt/ui": "^4.12.0",
    "@takumi-rs/core": "^2.18.2",
    "@vite-pwa/nuxt": "1.1.1",
    "@vueuse/core": "^15.0.0",
    "@vueuse/gesture": "^2.0.0",
    "@vueuse/motion": "^3.0.3",
    "@vueuse/nuxt": "^15.0.0",
    "consola": "^3.4.2",
    "date-fns": "^4.4.0",
    "dexie": "^4.4.7",
    "gsap": "^3.15.0",
    "h3": "^1.15.11",
    "nuxt": "^4.6.3",
    "nuxt-i18n-micro": "^3.30.1",
    "nuxt-umami": "3.2.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "uqr": "^0.1.3",
    "v-tour-guide": "^1.2.1",
    "valibot": "^1.5.0",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.147",
    "@nuxt/eslint": "^1.17.0",
    "@vite-pwa/assets-generator": "2.0.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "bunwright": "^0.3.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "fake-indexeddb": "^6.2.6",
    "happy-dom": "^21.0.4",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13"
  },
  "packageManager": "bun@1.4.4"
}
